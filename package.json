{
  "name": "Rutins",
  "version": "1.0.0",
  "description": "Aplicación para organización y seguimiento de hábitos y rutinas diarias",
  "main": "main.js",
  "homepage": "./",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-is-dev": "^3.0.1",
    "lucide": "^1.42.0"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rutins.app",
    "productName": "Rutins",
    "files": [
      "main.js",
      "preload.js",
      "ipcHandlers.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  },
  "author": "Angelo Cruz",
  "license": "UNLICENSED"
}
